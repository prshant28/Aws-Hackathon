rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: memories
    // Fields: title, summary, key_points, tags, domain, source_type, source_url, userId, created_at
    //
    // Collection: tasks
    // Fields: title, linked_memory_id, due_date, priority, status, userId, created_at
    //
    // Collection: schedules
    // Fields: title, date, time, duration_minutes, linked_task_id, gcal_event_id, userId, created_at
    //
    // Collection: interaction_logs
    // Fields: session_id, user_message, reply, agents_called, timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "prashantmaurya600@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidString(field, maxLen) {
      return request.resource.data[field] is string && request.resource.data[field].size() <= maxLen;
    }

    function isValidList(field, maxSize) {
      return request.resource.data[field] is list && request.resource.data[field].size() <= maxSize;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidMemory(data) {
      return data.keys().hasAll(['title', 'summary', 'userId', 'created_at']) &&
             data.title is string && data.title.size() <= 200 &&
             data.summary is string && data.summary.size() <= 1000 &&
             data.userId is string &&
             data.userId == request.auth.uid;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['title', 'status', 'userId', 'created_at']) &&
             data.title is string && data.title.size() <= 200 &&
             data.status in ['todo', 'in-progress', 'completed'] &&
             data.userId is string &&
             data.userId == request.auth.uid;
    }

    function isValidSchedule(data) {
      return data.keys().hasAll(['title', 'date', 'time', 'userId', 'created_at']) &&
             data.title is string && data.title.size() <= 200 &&
             data.userId is string &&
             data.userId == request.auth.uid;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Memories Collection
    match /memories/{memoryId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidMemory(request.resource.data);
      allow update: if isDocOwner() && isValidMemory(request.resource.data);
      allow delete: if isDocOwner() || isAdmin();
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidTask(request.resource.data);
      allow update: if isDocOwner() && isValidTask(request.resource.data);
      allow delete: if isDocOwner() || isAdmin();
    }

    // Schedules Collection
    match /schedules/{scheduleId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidSchedule(request.resource.data);
      allow update: if isDocOwner() && isValidSchedule(request.resource.data);
      allow delete: if isDocOwner() || isAdmin();
    }

    // Interaction Logs (Write-only for users, read-only for admins)
    match /interaction_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
    }
    
    // User Profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }
  }
}
