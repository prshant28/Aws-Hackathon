{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "fuser -k 8000/tcp 2>/dev/null; sleep 0.5; concurrently \"python main.py\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "analyze": "vite build && open dist/stats.html 2>/dev/null || xdg-open dist/stats.html 2>/dev/null || echo 'Bundle treemap written to dist/stats.html'",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "check:vendor-leaks": "bash scripts/check-no-vendor-leaks.sh",
    "start": "python main.py",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "export:deck-pdf": "node scripts/export-deck-pdf.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.7.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "rollup-plugin-visualizer": "^6.0.11",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.2"
  }
}
